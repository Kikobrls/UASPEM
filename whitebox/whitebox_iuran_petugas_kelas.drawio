    <mxCell id="p6-tb0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="1">
