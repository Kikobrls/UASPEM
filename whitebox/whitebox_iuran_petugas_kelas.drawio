    <mxCell id="p8-tb0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="1">
     <mxGeometry x="780" y="132" width="180" height="560" as="geometry" />
    </mxCell>
    <mxCell id="p8-tb1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="1" value="Dik:&lt;br&gt;Jumlah &lt;i&gt;node&lt;/i&gt; (n) = 12&lt;br&gt;Jumlah &lt;i&gt;edge&lt;/i&gt; (e) = 13&lt;br&gt;&lt;br&gt;&lt;b&gt;Rumus 1&lt;/b&gt;&lt;br&gt;V(G) = e &amp;#8722; n + 2&lt;br&gt;V(G) = 13 &amp;#8722; 12 + 2&lt;br&gt;V(G) = 3&lt;br&gt;&lt;br&gt;&lt;b&gt;Rumus 2&lt;/b&gt;&lt;br&gt;V(G) = P + 1&lt;br&gt;V(G) = 2 + 1&lt;br&gt;V(G) = 3">
     <mxGeometry x="960" y="132" width="210" height="560" as="geometry" />
    </mxCell>
    <mxCell id="p8-tb2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=10;align=left;verticalAlign=top;spacing=8;spacingTop=4;" vertex="1" parent="1" value="&lt;b&gt;Path 1 =&lt;/b&gt;&lt;br&gt;1,2,3,4,5,7,8,10,11,12&lt;br&gt;&lt;i&gt;(data valid → update berhasil → nama kelas berubah)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Path 2 =&lt;/b&gt;&lt;br&gt;1,2,3,4,5,6,4,5,7,8,10,11,12&lt;br&gt;&lt;i&gt;(nama kelas kosong → pesan error → input ulang → update berhasil)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Path 3 =&lt;/b&gt;&lt;br&gt;1,2,3,4,5,7,8,9,11,12&lt;br&gt;&lt;i&gt;(data valid → query gagal → pesan gagal ditampilkan)&lt;/i&gt;&lt;br&gt;&lt;br&gt;">
     <mxGeometry x="1170" y="132" width="300" height="560" as="geometry" />
    </mxCell>
